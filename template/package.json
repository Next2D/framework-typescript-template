{
  "name": "@next2d/framework-typescript-template",
  "version": "0.0.1",
  "description": "Next2D Framework TypeScript template.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "preview:web": "npx @next2d/builder --platform web --env prd --preview",
    "preview:ios": "npx @next2d/builder --platform ios --env prd --preview",
    "preview:android": "npx @next2d/builder --platform android --env prd --preview",
    "preview:macos": "npx @next2d/builder --platform macos --env prd --preview",
    "preview:windows": "npx @next2d/builder --platform windows --env prd --preview",
    "preview:linux": "npx @next2d/builder --platform linux --env prd --preview",
    "open:ios": "npx @next2d/builder --platform ios --env prd --open",
    "open:android": "npx @next2d/builder --platform android --env prd --open",
    "open:xbox": "npx @next2d/builder --platform xbox --env prd --open",
    "build:web": "npx @next2d/builder --platform web --env prd",
    "build:ios": "npx @next2d/builder --platform ios --env prd --build",
    "build:android": "npx @next2d/builder --platform android --env prd --build",
    "build:xbox": "npx @next2d/builder --platform xbox --env prd",
    "build:steam:windows": "npx @next2d/builder --platform steam:windows --env prd",
    "build:steam:macos": "npx @next2d/builder --platform steam:macos --env prd",
    "build:steam:linux": "npx @next2d/builder --platform steam:linux --env prd",
    "build:steam:manifest": "npx @next2d/builder --platform steam:macos --env prd --steam-manifest",
    "upload:steam": "npx @next2d/builder --steam-upload --env prd",
    "upload:steam:dry-run": "npx @next2d/builder --steam-upload --env prd --dry-run",
    "lint": "eslint src",
    "typecheck": "npx @next2d/vite-plugin-next2d-auto-loader && tsc --noEmit",
    "test": "npx vitest",
    "generate": "npx @next2d/view-generator"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next2d/vite-plugin-next2d-auto-loader": "^3.1.21",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/web-worker": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-webgl-canvas-mock": "^1.1.0"
  },
  "peerDependencies": {
    "@next2d/cache": "file:../../player/packages/cache",
    "@next2d/core": "file:../../player/packages/core",
    "@next2d/display": "file:../../player/packages/display",
    "@next2d/events": "file:../../player/packages/events",
    "@next2d/filters": "file:../../player/packages/filters",
    "@next2d/framework": "file:../../framework",
    "@next2d/geom": "file:../../player/packages/geom",
    "@next2d/media": "file:../../player/packages/media",
    "@next2d/net": "file:../../player/packages/net",
    "@next2d/player": "file:../../player",
    "@next2d/render-queue": "file:../../player/packages/render-queue",
    "@next2d/renderer": "file:../../player/packages/renderer",
    "@next2d/text": "file:../../player/packages/text",
    "@next2d/texture-packer": "file:../../player/packages/texture-packer",
    "@next2d/ui": "file:../../player/packages/ui",
    "@next2d/webgl": "file:../../player/packages/webgl",
    "@next2d/webgpu": "file:../../player/packages/webgpu"
  }
}
